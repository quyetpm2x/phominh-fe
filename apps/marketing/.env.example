# Địa chỉ backend (đọc phía server, không lộ ra trình duyệt).
BACKEND_API_URL="http://localhost:3000"

# Link tải app trên store (nhúng lúc build, đổi xong phải build lại). Bỏ trống: nút hiện "Sắp có", không bấm được.
NEXT_PUBLIC_APP_STORE_URL=""
NEXT_PUBLIC_GOOGLE_PLAY_URL=""

# Universal Links / App Links: để link https://phominh.vn/p/:id và /u/:id tự mở app. Đọc lúc chạy.
# Bỏ trống: /.well-known/apple-app-site-association và /.well-known/assetlinks.json trả 404.
# Team ID 10 ký tự, xem ở Apple Developer > Membership.
APPLE_TEAM_ID=""
# Vân tay SHA-256 chứng chỉ ký app Android (Play Console > App integrity); nhiều vân tay thì cách nhau dấu phẩy.
ANDROID_SHA256=""
